pipeline {
  agent {
    docker {
      image 'jibin321/maven-docker-agent:v2'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
    }
  }
  environment {
    DOCKER_IMAGE   = "dockernavaneeth/spring-boot-app/:${BUILD_NUMBER}"
    GIT_REPO_NAME  = "java-maven-sonar-argocd"
    GIT_USER_NAME  = "Navaneethkrishna-coder"
    APP_DIR        = "java-maven-sonar-argocd-helm-k8s/spring-boot-app"
  }
  options {
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }
  stages {
    stage('Checkout') {
      steps {
        sh 'echo "Checkout successful"'
        sh 'ls -ltr'
      }
    }
    stage('Build and Test') {
      steps {
        dir("${APP_DIR}") {
          sh 'mvn clean package'
        }
      }
    }
    stage('SonarQube Analysis') {
    steps {
        withSonarQubeEnv('sonarqube') {
            sh '''
                cd spring-boot-app
                mvn sonar:sonar \
                  -Dsonar.projectKey=my-ec2-project \
                  -Dsonar.projectName="Spring Boot App" \
                  -Dsonar.host.url=$SONAR_HOST_URL
            '''
        }
    }
}
    stage('Build and Push Docker Image') {
      steps {
        dir("${APP_DIR}") {
          script {
            sh 'docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} .'
            def dockerImage = docker.image("${DOCKER_IMAGE}:${BUILD_NUMBER}")
            docker.withRegistry('https://index.docker.io/v1/', 'docker-cred') {
              dockerImage.push()
              dockerImage.push('latest')
            }
          }
        }
      }
    }
    stage('Update Deployment File') {
      steps {
        withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
          sh '''
            git config user.email "navaneethkrishna008@gmail.com"
            git config user.name "${GIT_USER_NAME}"
            sed -i "s|image: .*|image: ${DOCKER_IMAGE}:${BUILD_NUMBER}|g" k8s/deployment.yml
            git add k8s/deployment.yml
            git commit -m "Update spring-boot app image to ${BUILD_NUMBER} [skip ci]" || echo "No changes to commit"
            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:main
          '''
        }
      }
    }
  }
  post {
    always {
      cleanWs()
    }
  }
}
